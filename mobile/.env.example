# Configuração de comunicação do app mobile com a API.
# Copie este arquivo para `mobile/.env` (ignorado pelo Git) e ajuste os valores.
# O Gradle lê estas chaves em tempo de build e grava a URL em BuildConfig.API_BASE_URL.

# Ambiente usado pelo build: local | prod
API_ENV=local

# API local. `10.0.2.2` é como o emulador Android alcança o host.
# Em aparelho físico use o IP da máquina na rede (ex.: http://192.168.0.10:8080)
# e acrescente esse host em androidApp/src/debug/res/xml/network_security_config.xml,
# porque HTTP só é liberado para os hosts listados lá, e somente no build debug.
API_BASE_URL_LOCAL=http://10.0.2.2:8080

# API de produção: somente a origem HTTPS, sem porta, caminho, query ou barra final.
# A API fica em loopback atrás do Nginx (ver docs/deploy/https-producao.md), então
# a porta 8080 não é publicada e uma URL com porta é rejeitada pelo build.
API_BASE_URL_PROD=https://gastos.exemplo.com
