# Ambiente da API resolvido em tempo de build (ADR-0029 / ADR-021).
# Copie para desktop/.env; o .env não é versionado.
#
# local -> usa API_BASE_URL_LOCAL   |   prod -> usa API_BASE_URL_PROD
API_ENV=local

# Origem http(s) sem caminho nem query. URL inválida derruba o build.
API_BASE_URL_LOCAL=http://localhost:8080
API_BASE_URL_PROD=https://api.exemplo.com.br
