POSTGRES_DB=controle_gastos
POSTGRES_USER=controle_gastos
POSTGRES_PASSWORD=change-me-local
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=refresh_token
AUTH_JWT_ISSUER=controle-gastos-api
AUTH_JWT_AUDIENCE=controle-gastos-clients
AUTH_ACCESS_TOKEN_LIFETIME=15m
AUTH_REFRESH_IDLE_LIFETIME=30d
AUTH_SESSION_ABSOLUTE_LIFETIME=365d
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_ATTEMPT_HMAC_SECRET=change-me-with-at-least-32-random-bytes
AUTH_JWT_KEY_ID=local-ephemeral
# Deixe vazias no desenvolvimento local para usar uma chave efêmera.
AUTH_JWT_PRIVATE_KEY_PATH=
AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWT_PREVIOUS_PUBLIC_KEY_PATH=
AUTH_JWT_PREVIOUS_KEY_ID=
# Produção: caminhos absolutos fora do repositório, usados por compose.production.yaml
# AUTH_JWT_PRIVATE_KEY_PATH_HOST=/srv/controle-gastos/secrets/jwt-private.pem
# AUTH_JWT_PUBLIC_KEY_PATH_HOST=/srv/controle-gastos/secrets/jwt-public.pem
NEXT_PUBLIC_API_URL=http://localhost:8080
