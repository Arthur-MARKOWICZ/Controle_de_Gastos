POSTGRES_DB=controle_gastos
POSTGRES_USER=controle_gastos
POSTGRES_PASSWORD=change-me-test-only
POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=refresh_token
AUTH_JWT_ISSUER=controle-gastos-api
AUTH_JWT_AUDIENCE=controle-gastos-clients
# Use ao menos 32 bytes aleatórios fora do teste local; nunca versione o valor real.
AUTH_JWT_SECRET=change-me-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_LIFETIME=15m
AUTH_REFRESH_IDLE_LIFETIME=30d
AUTH_SESSION_ABSOLUTE_LIFETIME=365d
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_ATTEMPT_HMAC_SECRET=change-me-with-at-least-32-random-bytes
# Base64 de exatamente 32 bytes aleatórios; gere com: openssl rand -base64 32
# Mantenha o mesmo valor entre reinícios/deploys: trocá-lo torna indecifráveis
# os segredos TOTP já cifrados no banco (ver docs/decisions/0019-mfa-totp.md).
AUTH_TOTP_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
AUTH_TOTP_ENCRYPTION_KEY_VERSION=1
AUTH_MFA_LOGIN_CHALLENGE_LIFETIME=5m
AUTH_MFA_PENDING_SETUP_LIFETIME=10m
AUTH_MFA_RECOVERY_SESSION_LIFETIME=10m
# Credenciais do OAuth App registrado no Google/GitHub; a redirect-uri deve apontar
# para o callback do próprio backend (.../api/v1/auth/oauth/google/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
NEXT_PUBLIC_API_URL=http://localhost:8080
